  "probe_policy": {
    "primary": "frozen_linear_probe",
    "classification_primary_metric": "mcc",
    "retain_task_native_primary_metric": true,
    "seeds": [13, 17, 42, 123, 997],
    "few_shot_regimes": [1, 10],
    "few_shot_task_ids": ["A01", "A02", "A03", "A04", "A05", "B11", "B12", "B16", "C05", "C08"],
    "few_shot_training_only": true,
    "validation_and_test_immutable": true,
    "regularization_grid": [0.01, 0.1, 1.0, 10.0, 100.0],
    "nonlinear_probe_sensitivity": {
      "enabled": false,
      "reason": "post-matrix optional check; frozen linear probing is primary and GENEB reported high rank stability",
      "hidden_units": 256,
      "activation": "relu",
      "task_ids": ["A01", "A02", "A04", "A05", "B16", "C05", "C08", "D01"]
    }
  },
  "pooling_policy": {
    "primary": "masked_mean",
    "rationale": "Nature Communications 2025 benchmark found mean pooling the most frequent task-wise winner; max and special-token pooling remain sensitivity analyses only.",
    "enabled_by_default": false,
    "sensitivity_methods": ["masked_mean", "masked_max", "special_token"],
    "sensitivity_task_ids": ["A01", "A02", "A04", "A05", "C05", "C08", "D01"]
  },
  "aggregation_policy": {
    "primary": "category_macro_average",
    "secondary": "task_micro_average",
    "classification_metric": "mcc",
    "report_specialization_score": true,
    "specialization_definition": "outside_category_mean_rank_minus_within_category_mean_rank",
    "report_hard_and_high_variance_tasks": true,
    "no_single_global_score_for_model_selection": true
  },
  "context_policy": {
    "common_context_track_bp": [512, 2048, 8192],
    "long_context_track": {
      "enabled": false,
      "reason": "activate only after per-model 2080Ti 32K/64K memory profiling; excluded from the default common-context launch",
      "task_ids": ["A06", "A07", "A08", "A09", "A10", "B14", "B15"],
      "contexts_bp": [6000, 32768, 65536],
      "separate_from_common_context_leaderboard": true,
      "only_models_with_native_capacity": true
    }
  },
  "resource_policy": {
    "gpu_host": "gpu05",
    "gpu_model": "RTX2080Ti_11GB",
    "max_tasks_per_gpu": 3,
    "default_max_workers": 3,
    "foreign_compute_allowed": true,
    "unknown_compute_blocks": true,
    "host_memory_reserved_mib": 16384,
    "stream_embeddings_to_float16_memmap": true,
    "gpu_telemetry_mode": "nvml_compute_apps_with_conservative_basic_fallback",
    "gpu_telemetry_cache_seconds": 5,
    "training_row_cap": 100000,
    "training_row_cap_applies_only_when_train_split_exceeds_cap": true,
    "validation_and_test_never_subsampled": true
  },
  "checkpoint_policy": {
    "selection": "explicit_user_supplied_checkpoint",
    "one_checkpoint_per_launch": true,
    "test_metrics_sealed_until_matrix_complete": true,
    "checkpoint_sweeps_are_monitoring_not_final_selection": true
  },
  "sources": [
    {
      "title": "Benchmarking DNA foundation models for genomic and genetic tasks",
      "doi": "10.1038/s41467-025-65823-8",
      "url": "https://www.nature.com/articles/s41467-025-65823-8",
      "code": "https://github.com/ChongWuLab/dna_foundation_benchmark",
      "used_for": ["pooling_policy", "variant_effect_protocol", "strict_group_split", "simple_probe_baselines", "runtime_reporting"]
    },
    {
      "title": "GENEB: Why Genomic Models Are Hard to Compare",
      "arxiv": "2606.04525",
      "url": "https://arxiv.org/abs/2606.04525",
      "used_for": ["fixed_five_seed_probe", "few_shot_regimes", "mcc", "category_macro_average", "specialization_score", "hard_task_panel", "plant_domain_alignment"]
    }
  ],
  "explicit_nonclaims": [
    "The GENEB arXiv manuscript does not provide a public code or data repository in the inspected version.",
    "Linear-probe ranking stability does not establish stability under full task-specific fine-tuning.",
